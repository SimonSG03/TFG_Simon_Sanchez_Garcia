<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        maxHeight="Infinity"
        maxWidth="Infinity"
        stylesheets="@styles/central.css"
        xmlns="http://javafx.com/javafx/25"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="es.simonsg.pmsuite.controller.CentralController">

   <!-- ================= BREADCRUMB ================= -->
   <top>
      <HBox alignment="CENTER_LEFT" spacing="8" styleClass="breadcrumb-bar">
         <padding>
            <Insets bottom="10" left="24" right="24" top="10" />
         </padding>
         <Button onAction="#volverInicio" styleClass="back-button" text="← Inicio" />
         <Label styleClass="breadcrumb-sep" text="/" />
         <Label styleClass="breadcrumb-active" text="Central" />
         <Region HBox.hgrow="ALWAYS" />
         <Label fx:id="updateLabel" styleClass="update-label" text="Actualizado: --:--" />
      </HBox>
   </top>

   <!-- ================= CONTENIDO PRINCIPAL ================= -->
   <center>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="main-scroll">
         <VBox spacing="16" styleClass="dashboard-root">
            <padding>
               <Insets bottom="28" left="24" right="24" top="12" />
            </padding>

            <!-- ===== ENCABEZADO ===== -->
            <HBox alignment="CENTER_LEFT">
               <VBox spacing="3">
                  <Label styleClass="page-title" text="Panel Central" />
                  <Label fx:id="fechaLabel" styleClass="page-subtitle" text="Resumen general · Cargando..." />
               </VBox>
            </HBox>

            <!-- ===== KPI CARDS ===== -->
            <HBox spacing="14">

               <!-- Ocupación -->
               <VBox alignment="CENTER_LEFT" spacing="5" styleClass="kpi-card-teal" HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets bottom="18" left="20" right="20" top="18" />
                  </padding>
                  <Label styleClass="kpi-card-label" text="OCUPACIÓN" />
                  <Label fx:id="kpiOcupacion" styleClass="kpi-card-value" text="--%"  />
                  <Label fx:id="kpiOcupacionSub" styleClass="kpi-card-sub" text="-- habitaciones" />
               </VBox>

               <!-- ADR -->
               <VBox alignment="CENTER_LEFT" spacing="5" styleClass="kpi-card-white" HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets bottom="18" left="20" right="20" top="18" />
                  </padding>
                  <Label styleClass="kpi-card-label-dark" text="ADR" />
                  <Label fx:id="kpiAdr" styleClass="kpi-card-value-dark" text="--,-- €" />
                  <Label styleClass="kpi-card-sub-dark" text="Precio medio por hab." />
               </VBox>

               <!-- RevPAR -->
               <VBox alignment="CENTER_LEFT" spacing="5" styleClass="kpi-card-white" HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets bottom="18" left="20" right="20" top="18" />
                  </padding>
                  <Label styleClass="kpi-card-label-dark" text="RevPAR" />
                  <Label fx:id="kpiRevpar" styleClass="kpi-card-value-dark" text="--,-- €" />
                  <Label styleClass="kpi-card-sub-dark" text="Ingreso por hab. disponible" />
               </VBox>

               <!-- Ingresos hoy -->
               <VBox alignment="CENTER_LEFT" spacing="5" styleClass="kpi-card-green" HBox.hgrow="ALWAYS">
                  <padding>
                     <Insets bottom="18" left="20" right="20" top="18" />
                  </padding>
                  <Label styleClass="kpi-card-label" text="INGRESOS HOY" />
                  <Label fx:id="kpiIngresos" styleClass="kpi-card-value" text="--,-- €" />
                  <Label fx:id="kpiIngresosPendiente" styleClass="kpi-card-sub" text="Pendiente: --,-- €" />
               </VBox>

            </HBox>

            <!-- ===== LLEGADAS Y SALIDAS ===== -->
            <HBox spacing="14">

               <!-- Llegadas del día -->
               <VBox spacing="10" styleClass="dash-card" HBox.hgrow="ALWAYS">
                  <HBox alignment="CENTER_LEFT">
                     <VBox spacing="2">
                        <Label styleClass="card-title" text="Llegadas de hoy" />
                        <Label fx:id="llegadasSubtitle" styleClass="card-subtitle" text="Cargando..." />
                     </VBox>
                     <Region HBox.hgrow="ALWAYS" />
                     <Label fx:id="llegadasBadge" styleClass="badge-success" text="--" />
                  </HBox>
                  <Separator />
                  <VBox fx:id="llegadasList" spacing="8" />
               </VBox>

               <!-- Salidas del día -->
               <VBox spacing="10" styleClass="dash-card" HBox.hgrow="ALWAYS">
                  <HBox alignment="CENTER_LEFT">
                     <VBox spacing="2">
                        <Label styleClass="card-title" text="Salidas de hoy" />
                        <Label fx:id="salidasSubtitle" styleClass="card-subtitle" text="Cargando..." />
                     </VBox>
                     <Region HBox.hgrow="ALWAYS" />
                     <Label fx:id="salidasBadge" styleClass="badge-success" text="--" />
                  </HBox>
                  <Separator />
                  <VBox fx:id="salidasList" spacing="8" />
               </VBox>

            </HBox>

            <!-- ===== ESTADO DE HABITACIONES + FUERA SERVICIO + GRÁFICO ===== -->
            <HBox spacing="14">

               <!-- Estado de habitaciones -->
               <VBox spacing="12" styleClass="dash-card" HBox.hgrow="ALWAYS">
                  <Label styleClass="card-title" text="Estado de habitaciones" />
                  <Separator />

                  <HBox spacing="0" alignment="CENTER">
                     <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS">
                        <Label fx:id="statOcupadas" styleClass="stat-value-teal" text="--" />
                        <Label styleClass="stat-label" text="Ocupadas" />
                     </VBox>
                     <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS">
                        <Label fx:id="statLibres" styleClass="stat-value-green" text="--" />
                        <Label styleClass="stat-label" text="Libres" />
                     </VBox>
                     <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS">
                        <Label fx:id="statFuera" styleClass="stat-value-red" text="--" />
                        <Label styleClass="stat-label" text="F. Servicio" />
                     </VBox>
                     <VBox alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS">
                        <Label fx:id="statBloqueadas" styleClass="stat-value-amber" text="--" />
                        <Label styleClass="stat-label" text="Bloqueadas" />
                     </VBox>
                  </HBox>

                  <!-- Barra de ocupación proporcional -->
                  <VBox spacing="4">
                     <HBox spacing="3">
                        <Region fx:id="barOcupadas" styleClass="bar-teal" HBox.hgrow="ALWAYS" />
                        <Region fx:id="barLibres" styleClass="bar-green" style="-fx-pref-width: 32;" />
                        <Region fx:id="barFuera" styleClass="bar-red" style="-fx-pref-width: 7;" />
                     </HBox>
                     <HBox spacing="16">
                        <Label fx:id="barOcupadasLabel" styleClass="bar-label" text="Ocupadas -%" />
                        <Label fx:id="barLibresLabel" styleClass="bar-label" text="Libres -%" />
                        <Label fx:id="barFueraLabel" styleClass="bar-label" text="F. Servicio -%" />
                     </HBox>
                  </VBox>
               </VBox>

               <!-- Habitaciones fuera de servicio / bloqueadas -->
               <VBox spacing="10" styleClass="dash-card" style="-fx-pref-width: 270;">
                  <Label styleClass="card-title" text="Fuera de servicio" />
                  <Separator />
                  <VBox fx:id="fueraServicioList" spacing="8" />
                  <Label fx:id="fueraServicioTotal" styleClass="card-subtitle" text="" />
               </VBox>

               <!-- Gráfico de ocupación -->
               <VBox alignment="CENTER" spacing="10" styleClass="dash-card" style="-fx-pref-width: 200;">
                  <Label styleClass="card-title" text="Ocupación actual" />
                  <Separator />
                  <PieChart fx:id="ocupacionChart" prefHeight="140" prefWidth="140" labelsVisible="false" legendVisible="false" />
                  <HBox alignment="CENTER" spacing="12">
                     <HBox alignment="CENTER_LEFT" spacing="5">
                        <Region styleClass="legend-teal" />
                        <Label styleClass="legend-label" text="Ocupadas" />
                     </HBox>
                     <HBox alignment="CENTER_LEFT" spacing="5">
                        <Region styleClass="legend-green" />
                        <Label styleClass="legend-label" text="Libres" />
                     </HBox>
                  </HBox>
               </VBox>

            </HBox>

            <!-- ===== ALERTAS E INCIDENCIAS ===== -->
            <HBox spacing="14">

               <!-- Alertas del sistema -->
               <VBox spacing="10" styleClass="dash-card" HBox.hgrow="ALWAYS">
                  <HBox alignment="CENTER_LEFT">
                     <Label styleClass="card-title" text="Alertas del sistema" />
                     <Region HBox.hgrow="ALWAYS" />
                     <Label fx:id="alertasCriticasBadge" styleClass="badge-danger" text="" />
                  </HBox>
                  <Separator />
                  <VBox fx:id="alertasList" spacing="10" />
               </VBox>

               <!-- Overbooking e incidencias -->
               <VBox spacing="10" styleClass="dash-card" HBox.hgrow="ALWAYS">
                  <HBox alignment="CENTER_LEFT">
                     <Label styleClass="card-title" text="Overbooking e incidencias" />
                     <Region HBox.hgrow="ALWAYS" />
                     <Label fx:id="overbookingBadge" styleClass="badge-danger" text="0 activos" />
                  </HBox>
                  <Separator />
                  <VBox fx:id="overbookingContainer" spacing="8" />
               </VBox>

            </HBox>

         </VBox>
      </ScrollPane>
   </center>

</BorderPane>
