               <Button prefHeight="102" prefWidth="122" styleClass="main-tile" onAction="#abrirPrecios">
                  <graphic>
                     <VBox alignment="CENTER">
                        <ImageView fitHeight="63" fitWidth="62">
                           <image>
                              <Image url="@../../../images/ico_buttons/billete.png" />
                           </image>
                        </ImageView>
                        <Label text="Precios" textFill="WHITE" />
                     </VBox>
                  </graphic>
               </Button>
            </HBox>

            <!-- ===== FILA 2 ===== -->
            <HBox alignment="CENTER" spacing="18" styleClass="module-button">
               <Button prefHeight="102" prefWidth="122" styleClass="main-tile" onAction="#abrirMantenimiento">
                  <graphic>
                     <VBox alignment="CENTER">
                        <ImageView fitHeight="60" fitWidth="60">
                           <image>
                              <Image url="@../../../images/ico_buttons/herramienta.png" />
                           </image>
                        </ImageView>
                        <Label text="Mantenimiento" textFill="WHITE" />
                     </VBox>
                  </graphic>
               </Button>

               <Button prefHeight="102" prefWidth="122" styleClass="main-tile" onAction="#abrirAdministracion">
                  <graphic>
                     <VBox alignment="CENTER">
                        <ImageView fitHeight="61" fitWidth="57">
                           <image>
                              <Image url="@../../../images/ico_buttons/calculadora.png" />
                           </image>
                        </ImageView>
                        <Label text="Administracion" textFill="WHITE" />
                     </VBox>
                  </graphic>
               </Button>

               <Button prefHeight="102" prefWidth="122" styleClass="main-tile" onAction="#abrirRestauracion">
                  <graphic>
                     <VBox alignment="CENTER">
                        <ImageView fitHeight="61" fitWidth="56">
                           <image>
                              <Image url="@../../../images/ico_buttons/cubiertos.png" />
                           </image>
                        </ImageView>
                        <Label text="Restauracion" textFill="WHITE" />
                     </VBox>
                  </graphic>
               </Button>

               <Button prefHeight="102" prefWidth="122" styleClass="main-tile"
                       onAction="#abrirInformes">
                  <graphic>
                     <VBox alignment="CENTER">
                        <ImageView fitHeight="59" fitWidth="55">
                           <image>
                              <Image url="@../../../images/ico_buttons/papel-bajo-lupa.png" />
                           </image>
                        </ImageView>
                        <Label text="Informes" textFill="WHITE" />
                     </VBox>
                  </graphic>
               </Button>
            </HBox>

            <!-- ===== FILA 3 ===== -->
            <HBox alignment="CENTER" spacing="18">
               <Button prefHeight="102" prefWidth="261" styleClass="main-tile" onAction="#abrirComunicacion">
                  <graphic>
                     <VBox alignment="CENTER">
                        <ImageView fitHeight="56" fitWidth="64">
                           <image>
                              <Image url="@../../../images/ico_buttons/correo-electronico.png" />
                           </image>
                        </ImageView>
                        <Label text="Comunicacion" textFill="WHITE" />
                     </VBox>
                  </graphic>
               </Button>

               <Button prefHeight="102" prefWidth="261" styleClass="main-tile" onAction="#abrirMaestros">
                  <graphic>
                     <VBox alignment="CENTER">
                        <ImageView fitHeight="58" fitWidth="60">
                           <image>
                              <Image url="@../../../images/ico_buttons/llave.png" />
                           </image>
                        </ImageView>
                        <Label text="Maestros" textFill="WHITE" />
                     </VBox>
                  </graphic>
               </Button>
            </HBox>

         </VBox>

         <!-- ================= DASHBOARD DERECHA =================
         <VBox spacing="20" prefWidth="350" minWidth="350" styleClass="dashboard">
            <padding>
               <Insets bottom="24" left="20" right="20" top="24" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10">
               <Label styleClass="dashboard-title" text="Dashboard" />
               <Region HBox.hgrow="ALWAYS" />
               <Label fx:id="updateLabel" styleClass="dashboard-subtitle" text="Actualizado a las 00:00" />
            </HBox>

            <HBox spacing="10" alignment="CENTER">
