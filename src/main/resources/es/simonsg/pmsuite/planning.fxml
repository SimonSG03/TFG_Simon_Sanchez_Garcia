<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane
        maxHeight="Infinity"
        maxWidth="Infinity"
        stylesheets="@styles/planning.css"
        xmlns="http://javafx.com/javafx/25"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="es.simonsg.pmsuite.controller.PlanningController">

    <!-- ═══════════════════ TOP ═══════════════════ -->
    <top>
        <VBox styleClass="dashboard-root">

            <!-- Breadcrumb -->
            <HBox styleClass="breadcrumb-bar" alignment="CENTER_LEFT" spacing="8">
                <padding><Insets top="8" right="16" bottom="8" left="16"/></padding>
                <Button styleClass="back-button" text="← Inicio" onAction="#volverInicio"/>
                <Label styleClass="breadcrumb-sep" text="/"/>
                <Label styleClass="breadcrumb-active" text="Planning"/>
                <Label styleClass="breadcrumb-sep" text="/"/>
                <Label styleClass="breadcrumb-active" text="Room Rack"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="updateLabel" styleClass="update-label" text=""/>
            </HBox>

            <!-- Controls bar -->
            <HBox styleClass="planning-controls-bar" alignment="CENTER_LEFT" spacing="14">
                <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>

                <!-- Title -->
                <VBox spacing="2">
                    <Label styleClass="page-title" text="Planning">
                        <font><Font size="20"/></font>
                    </Label>
                    <Label fx:id="subtitleLabel" styleClass="page-subtitle" text="Room Rack"/>
                </VBox>

                <!-- Overbooking alert -->
                <Label fx:id="overbookingAlert" styleClass="overbooking-alert" text="" visible="false"/>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Month navigation -->
                <HBox alignment="CENTER" spacing="6" styleClass="month-nav-box">
                    <Button styleClass="nav-btn" text="‹" onAction="#irMesAnterior"/>
                    <Label fx:id="labelMes" styleClass="month-label" text="Marzo 2026"
                           minWidth="148" alignment="CENTER"/>
                    <Button styleClass="nav-btn" text="›" onAction="#irMesSiguiente"/>
                    <Button styleClass="today-btn" text="Hoy" onAction="#irHoy"/>
                </HBox>

                <!-- Filters -->
                <HBox alignment="CENTER" spacing="8">
                    <Label styleClass="filter-label" text="Tipo:"/>
                    <ComboBox fx:id="filtroTipo" prefWidth="132" onAction="#aplicarFiltros"/>
                    <Label styleClass="filter-label" text="Estado:"/>
                    <ComboBox fx:id="filtroEstado" prefWidth="132" onAction="#aplicarFiltros"/>
                </HBox>

                <!-- Actions -->
                <Button styleClass="btn-primary" text="+ Reserva" onAction="#nuevaReserva"/>
                <Button styleClass="btn-outline" text="🔒 Bloquear" onAction="#accionBloquear"/>
            </HBox>

            <!-- Legend -->
            <HBox fx:id="leyendaBar" styleClass="legend-bar" alignment="CENTER_LEFT" spacing="18">
                <padding><Insets top="6" right="16" bottom="6" left="16"/></padding>
            </HBox>

        </VBox>
    </top>

    <!-- ═══════════════════ CENTER ═══════════════════ -->
    <center>
        <BorderPane fx:id="rackPane" styleClass="rack-container"/>
    </center>

</BorderPane>